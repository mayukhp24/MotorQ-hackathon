# FleetPulse local configuration. Copy to .env and adjust; every value below is
# also the built-in default in docker-compose.yml, so the stack starts without
# a .env file. These are LOCAL-ONLY secrets: production reads real secrets from
# the cloud secret manager (see deploy/helm and infra/terraform).

# ---------------------------------------------------------------- scale
SIM_VEHICLES=100000            # must match the seeded fleet (the simulator regenerates the same world)
SIM_INTERVAL=5s                # per-vehicle reporting period; 1s = 100K events/s (needs a large machine)
SIM_MAX_EPS=0                  # optional global cap on simulator events/s (0 = none)
SIM_TRANSPORT=mqtt             # mqtt | http
SIM_BURST_EVERY=30m            # shift-start burst: 3x rate for SIM_BURST_FOR
SIM_BURST_FOR=5m
SIM_OUTAGE_EVERY=10m           # some vehicles lose connectivity, then flush their backlog
SIM_OUTAGE_FOR=20s
SEED_HISTORY_DAYS=60           # history generated by the seed job (drives the ML training window)
PROCESSOR_REPLICAS=2
API_WORKERS=4
TELEMETRY_PARTITIONS=12

# ---------------------------------------------------------------- retention (laptop-sized)
TELEMETRY_RETENTION_H=2
TELEMETRY_RETENTION_BYTES=268435456
CH_HOT_DAYS=1
CH_RETENTION_DAYS=3
CH_KAFKA_CONSUMERS=4

# ---------------------------------------------------------------- credentials (local only)
POSTGRES_PASSWORD=postgres-local-only
DB_API_PASSWORD=api-local-only
DB_WRITER_PASSWORD=writer-local-only
REDIS_PASSWORD=redis-local-only
CLICKHOUSE_PASSWORD=clickhouse-local-only
CLICKHOUSE_RO_PASSWORD=clickhouse-ro-local-only
MQTT_GATEWAY_PASSWORD=gateway-local-only
MQTT_CONNECTOR_PASSWORD=connector-local-only
GRAFANA_ADMIN_PASSWORD=grafana-local-only
INGEST_API_KEYS=aurora:aurora-local-key,pinnacle:pinnacle-local-key,stellar:stellar-local-key
PII_ENCRYPTION_KEY=local-dev-pii-key-change-me
SEED_DEMO_PASSWORD=FleetPulse!2026
# RS256 signing key (PEM). Empty: the API generates one and shares it via Redis.
JWT_PRIVATE_KEY_PEM=

# ---------------------------------------------------------------- copilot
# Optional. With nothing set, the copilot answers with its deterministic offline
# planner. Any OpenAI-compatible endpoint works (pick a model that supports tool /
# function calling; check the provider's current model list). Examples:
#   Groq (free tier):        LLM_BASE_URL=https://api.groq.com/openai/v1
#                            LLM_MODEL=openai/gpt-oss-120b
#   Google Gemini (free):    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                            LLM_MODEL=gemini-2.0-flash
#   OpenRouter (free models):LLM_BASE_URL=https://openrouter.ai/api/v1
#                            LLM_MODEL=<a tool-capable model id ending in :free>
#   Ollama (local, no key):  LLM_BASE_URL=http://host.docker.internal:11434/v1
#                            LLM_MODEL=qwen2.5:7b
LLM_PROVIDER=auto              # auto | openai | anthropic | offline
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5      # set to your provider's model when LLM_BASE_URL is used
# Claude instead (used only when LLM_BASE_URL is empty):
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- misc
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
ANALYTICS_SCHEDULE=daily
IMAGE_TAG=dev
# Corporate TLS-inspecting proxy? Point this at its CA bundle for image builds.
EXTRA_CA_FILE=./deploy/no-extra-ca.pem
